# ターミナルの作業ディレクトリ(Linux: /home/..., macOS: /Users/...)
PROJECT_DIR=/home/<username>/projects/<固定ディレクトリ名>
LOGIN_PASSWORD_HASH=<bcryptハッシュ済みパスワード>
SESSION_SECRET=<ランダムな長い文字列>
# ターミナルは固定6枠、実際のtmuxセッション名はこの値+"-1"〜"-6"になる
TMUX_SESSION_NAME=console
PORT=8443
MAX_ACTIVE_STREAMS=3
# ウィンドウ一覧から除外するタイトルの部分文字列(カンマ区切り、任意)。このWebアプリ自身のブラウザウィンドウ等を除外する場合に使う。
WINDOW_TITLE_EXCLUDE=
