{
  "name": "remote-console-web",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/node-pty/prebuilds/'+process.platform+'-'+process.arch+'/spawn-helper';if(fs.existsSync(p))fs.chmodSync(p,0o755)\""
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
